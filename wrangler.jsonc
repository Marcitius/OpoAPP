{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opoapp",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "not_found_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET"
    }
  ],

  "observability": {
    "enabled": true
  }
}
