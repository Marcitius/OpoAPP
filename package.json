{
  "name": "opogc",
  "version": "11.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/prepare-pwa.mjs && next build --webpack && node scripts/prepare-pwa.mjs --built",
    "start": "serve out -l 3000",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-preserved.mjs && node --import tsx tests/database.test.ts && node --import tsx tests/data.test.ts",
    "test:ui": "playwright test",
    "test:live": "node --import tsx --env-file=.env.local scripts/test-live.ts",
    "check:preserved": "node scripts/check-preserved.mjs"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@supabase/supabase-js": "^2.57.4",
    "@tailwindcss/postcss": "^4.2.1",
    "isomorphic-dompurify": "^2.30.1",
    "next": "16.2.6",
    "pdfjs-dist": "^5.4.149",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "^4.2.1",
    "ts-fsrs": "^5.2.0",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.2",
    "prettier": "^3.9.9",
    "serve": "^14.2.5",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vite": "^8.3.1"
  }
}
